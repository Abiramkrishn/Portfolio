# ── Database ─────────────────────────────────────────────────────────────
# Local: `docker compose up -d db` exposes Postgres on port 5433.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5433/portfolio
# Prepared statements are turned off automatically for Neon "-pooler" and Supabase :6543 URLs.
# Set to false for any other transaction-mode pooler (PgBouncer).
DATABASE_PREPARE=true
# Optional direct (unpooled) URL for migrations. Vercel's Neon integration sets it for you.
# DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=5

# ── Site ─────────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs, Open Graph images and the sitemap.
SITE_URL=http://localhost:3000

# ── Dashboard (generate with: npm run admin:setup -- you@example.com "passphrase" [--totp]) ──
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH_B64=
# Optional second factor (base32). Leave empty to disable.
ADMIN_TOTP_SECRET=
# 32+ random characters. Used for HMACs (IP hashing, form tokens).
AUTH_SECRET=

# ── Optional: email new briefs to you ─────────────────────────────────────
# Gmail: SMTP_PASS is a Google App Password (needs 2-Step Verification), not your normal password.
# Create one at https://myaccount.google.com/apppasswords. Port 465 (TLS) or 587 (STARTTLS) both work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM="Portfolio briefs <you@gmail.com>"
NOTIFY_EMAIL=you@gmail.com
